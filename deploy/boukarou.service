[Unit]
Description=Boukarou - self-hosted LXC panel
Documentation=https://github.com/toscani-tenekeu/boukarou
After=network-online.target snap.lxd.daemon.service lxd.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/boukarou/boukarou.env
WorkingDirectory=/opt/boukarou
ExecStart=/usr/local/bin/bun server/index.ts
Restart=on-failure
RestartSec=5
# The panel drives LXD, nginx, certbot and ufw, so it runs as root.
# No NoNewPrivileges/ProtectHome: the snap-packaged `lxc` client needs to
# change its AppArmor profile and write to /root/snap.
User=root
PrivateTmp=true

[Install]
WantedBy=multi-user.target
